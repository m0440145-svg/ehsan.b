# انسخ هذا الملف إلى .env وعدّل القيم
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# قاعدة البيانات (PostgreSQL في الإنتاج)
# DATABASE_URL=postgres://ehsan:password@localhost:5432/ehsan_tasks
# عند عدم التحديد يُستخدم SQLite محليًا للتطوير فقط

# أمان الدخول
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
OTP_ENABLED=False

# البريد الإلكتروني (للتنبيهات لاحقًا)
EMAIL_NOTIFICATIONS_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=tasks@ehsan.org.sa

# WhatsApp API (لاحقًا)
WHATSAPP_ENABLED=False
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
